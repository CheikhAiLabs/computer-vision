# Optional: defaults already work without creating .env.
# Override the Compose project name; labctl discovers network/container identities.
COMPOSE_PROJECT_NAME=computer-vision
# Python service logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional local semantic inference; raw video and classical CV remain independent.
ENABLE_YOLO=true
YOLO_MODEL=/models/yolo26n.pt
YOLO_CONFIDENCE=0.45
YOLO_EVERY_N_FRAMES=5
YOLO_THREADS=2
# Normalized x1,y1,x2,y2; positive-area person-box overlap raises a demo event.
YOLO_RESTRICTED_ZONE=0.60,0.16,0.98,0.86
YOLO_RESULT_TTL_SECONDS=3
ENABLE_ANNOTATED_STREAM=true

# Local demonstration credentials only; use a private .env for real credentials.
POSTGRES_DB=computer_vision
POSTGRES_USER=incidents
POSTGRES_PASSWORD=local-demo-only
# Optional SQLAlchemy URL overrides the individual PostgreSQL settings.
# INCIDENT_DATABASE_URL=postgresql+psycopg://user:password@incident-db:5432/database
INCIDENT_CORRELATION_WINDOW_SECONDS=90
# Negative disables automatic resolution; manual closure still requires recovered alerts.
INCIDENT_AUTO_RESOLVE_SECONDS=30
INCIDENT_SIGNAL_INTERVAL_SECONDS=10
INCIDENT_SIGNAL_MAX_AGE_SECONDS=30
